# Admin page (/admin) password. Required to view enquiries and bookings.
ADMIN_PASSWORD=                    # 10+ characters. On the live site, a short or easy one keeps the admin locked.
ADMIN_SECRET=                      # optional extra random text. Changing it signs everyone out of the admin.

# Public site address, used in the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://menulift.in

# Optional: a fixed Google Meet link shown after booking.
NEXT_PUBLIC_MEET_LINK=

# Analytics. Each one switches on when its value is filled in.
NEXT_PUBLIC_GA_ID=                 # GA4, like G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=         # Meta Pixel ID
NEXT_PUBLIC_CLARITY_ID=            # Microsoft Clarity project ID
NEXT_PUBLIC_GADS_ID=               # Google Ads, like AW-1234567890
NEXT_PUBLIC_GADS_BOOKING_LABEL=    # Google Ads conversion label for a booked call

# Meta Conversions API (server side). Needs the Pixel ID above plus this token.
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=              # optional, only while testing in Events Manager

# Storage. Leave empty to use a local SQLite file (data/menulift.db) for testing.
# Paste a Postgres connection string (Netlify DB, Neon, Supabase, Railway...) to store in Postgres instead.
# The table is created automatically on first use.
DATABASE_URL=
